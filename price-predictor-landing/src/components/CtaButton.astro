---
import { APP_URL } from "../config";
interface Props {
  variant?: "primary" | "dark";
  class?: string;
}
const { variant = "primary", class: className = "" } = Astro.props;
const colors =
  variant === "primary"
    ? "bg-action text-navy-900 hover:bg-action-hover"
    : "bg-navy-900 text-white hover:bg-blue-800";
---
<a
  href={APP_URL}
  class:list={["btn flex items-center justify-center rounded-xl font-semibold", colors, className]}
>Проверить билет</a>
