---
import CtaButton from "./CtaButton.astro";
---
<section class="px-4 pt-8 pb-12 sm:px-6 lg:pt-14 lg:pb-20">
  <div class="mx-auto flex max-w-[1120px] flex-col items-start gap-5 rounded-[18px] bg-white p-6 shadow-[var(--shadow-card)] lg:flex-row lg:items-center lg:justify-between lg:p-10">
    <div>
      <h2 class="m-0 text-[24px] leading-tight font-semibold tracking-[-.02em] lg:text-[32px]">Проверьте свой маршрут</h2>
      <p class="mt-2 text-sm leading-6 text-muted lg:text-base">Укажите билет и посмотрите тестовый прогноз цены.</p>
    </div>
    <CtaButton class="h-14 w-full shrink-0 text-base sm:w-auto sm:px-8" />
  </div>
</section>
