---
import Logo from "./Logo.astro";
import CtaButton from "./CtaButton.astro";
---
<section class="px-4 pb-9 lg:px-10 lg:pb-20 xl:px-20">
  <div class="mx-auto flex flex-col overflow-hidden rounded-[26px] bg-[linear-gradient(180deg,#3781fc,#1951fc)] text-white lg:grid lg:max-w-[1200px] lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] lg:items-stretch lg:rounded-[32px] lg:bg-[linear-gradient(90deg,#3781fc,#1951fc)]">
    <div class="flex flex-col items-center px-[22px] pt-7 pb-[22px] lg:flex-row lg:px-14 lg:py-12">
      <Logo variant="light" circleClass="size-10 lg:size-[52px]" dotClass="size-[11px] lg:size-3.5" textClass="text-[20px] lg:text-[28px]" class="flex-col gap-2.5 lg:flex-row lg:gap-4" />
    </div>
    <div class="relative mx-3.5 border-t-2 border-dashed border-white/40 lg:hidden" aria-hidden="true">
      <div class="absolute -top-[11px] -left-[25px] size-5 rounded-full bg-bg"></div>
      <div class="absolute -top-[11px] -right-[25px] size-5 rounded-full bg-bg"></div>
    </div>
    <div class="relative my-[18px] hidden border-l-2 border-dashed border-white/40 lg:block" aria-hidden="true">
      <div class="absolute -top-8 -left-3.5 size-[26px] rounded-full bg-bg"></div>
      <div class="absolute -bottom-8 -left-3.5 size-[26px] rounded-full bg-bg"></div>
    </div>
    <div class="p-[22px] lg:flex lg:items-center lg:justify-end lg:px-14 lg:py-12">
      <CtaButton class="h-[58px] text-[17px] shadow-[0_10px_30px_rgba(3,25,91,.3)] lg:h-16 lg:w-[340px] lg:text-[19px] lg:shadow-[0_12px_34px_rgba(3,25,91,.3)]" />
    </div>
  </div>
</section>
