---
interface Props {
  variant?: "dark" | "light";
  class?: string;
  circleClass: string;
  dotClass: string;
  textClass: string;
}
const { variant = "dark", class: className = "", circleClass, dotClass, textClass } = Astro.props;
const circleBg = variant === "dark" ? "bg-navy-900" : "bg-white";
const dotBg = variant === "dark" ? "bg-white" : "bg-navy-900";
---
<div class:list={["flex items-center", className]}>
  <div class:list={["grid place-items-center rounded-[10px]", circleBg, circleClass]} aria-hidden="true">
    <div class:list={["rounded-full", dotBg, dotClass]}></div>
  </div>
  <span class:list={["font-semibold", textClass]}>Чекбилет</span>
</div>
