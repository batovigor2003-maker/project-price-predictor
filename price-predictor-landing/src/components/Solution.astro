---
import ForecastCard from "./ForecastCard.astro";
---
<section class="px-4 py-7 lg:px-10 lg:py-16 xl:px-20">
  <div class="mx-auto flex flex-col items-center gap-5 rounded-[26px] bg-[linear-gradient(180deg,#cbe9fd,#9fcafd)] px-[22px] py-[30px] text-center lg:grid lg:max-w-[1200px] lg:grid-cols-2 lg:items-center lg:gap-14 lg:rounded-[36px] lg:bg-[linear-gradient(135deg,#cbe9fd,#9fcafd)] lg:py-16 lg:pr-10 lg:pl-16 lg:text-left">
    <div class="flex flex-col items-center gap-5 lg:items-start">
      <h2 class="m-0 text-[20px] leading-[1.35] font-medium [text-wrap:pretty] lg:text-[30px] lg:leading-[1.3] lg:tracking-[-0.01em]">
        Чекбилет оценит, как может измениться цена в ближайшее время: вырастет, снизится или останется примерно такой же.
      </h2>
    </div>
    <ForecastCard />
  </div>
</section>
