---
import { DEMO, formatRub } from "../data/forecast";
const differenceRub = DEMO.boughtYesterdayRub - DEMO.todayRub;
---
<section class="px-4 py-8 sm:px-6 lg:py-14">
  <div class="mx-auto grid max-w-[1120px] gap-6 lg:grid-cols-2 lg:items-center lg:gap-16">
    <h2 class="m-0 max-w-[500px] text-[25px] leading-[1.2] font-semibold tracking-[-.02em] lg:text-[38px]">
      Купили авиабилет, а на следующий день он подешевел?
    </h2>
    <div class="rounded-[18px] bg-white p-5 shadow-[var(--shadow-card)] lg:p-7">
      <p class="text-xs font-medium text-muted">Тестовый пример изменения цены</p>
      <div class="mt-5 grid grid-cols-2">
        <div class="border-r border-line pr-3"><p class="text-xs text-muted">Вчера</p><p class="mt-1 text-xl font-semibold lg:text-2xl">{formatRub(DEMO.boughtYesterdayRub)}</p></div>
        <div class="pl-4"><p class="text-xs text-muted">Сегодня</p><p class="mt-1 text-xl font-semibold lg:text-2xl">{formatRub(DEMO.todayRub)}</p></div>
      </div>
      <p class="mt-5 border-t border-line pt-4 text-sm font-medium">Разница в этом примере <span class="font-semibold text-blue-600">{formatRub(differenceRub)}</span></p>
    </div>
  </div>
</section>
