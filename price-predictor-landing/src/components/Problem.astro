---
import { DEMO, formatRub } from "../data/forecast";

const lossRub = DEMO.boughtYesterdayRub - DEMO.todayRub;
---
<section class="px-[22px] pt-14 pb-7 lg:px-10 lg:pt-[120px] lg:pb-16 xl:px-20">
  <div class="mx-auto flex flex-col items-center gap-[22px] text-center lg:grid lg:max-w-[1120px] lg:grid-cols-2 lg:items-center lg:gap-16 lg:text-left">
    <div class="flex flex-col items-center gap-[22px] lg:items-start lg:gap-5">
      <h2 class="m-0 text-[26px] leading-[1.2] font-semibold tracking-[-0.015em] lg:text-[44px] lg:leading-[1.12] lg:tracking-[-0.02em]">
        Купили авиабилет, а на следующий день он подешевел?
      </h2>
    </div>
    <div class="grid w-full grid-cols-2 gap-2.5 text-left lg:gap-4">
      <div class="flex flex-col gap-1 rounded-[18px] border border-loss-border bg-loss-soft px-4 py-3.5 lg:gap-2 lg:rounded-[22px] lg:px-[26px] lg:py-6">
        <span class="text-[12px] text-muted lg:text-[15px]">Купили вчера</span>
        <span class="text-[19px] font-semibold text-loss line-through decoration-loss lg:text-[30px]">{formatRub(DEMO.boughtYesterdayRub)}</span>
      </div>
      <div class="flex flex-col gap-1 rounded-[18px] border border-line bg-white px-4 py-3.5 lg:gap-2 lg:rounded-[22px] lg:px-[26px] lg:py-6">
        <span class="text-[12px] text-muted lg:text-[15px]">Сегодня</span>
        <span class="text-[19px] font-semibold text-blue-600 lg:text-[30px]">{formatRub(DEMO.todayRub)}</span>
      </div>
      <div class="col-span-full flex items-center justify-between gap-2.5 rounded-2xl bg-loss-tint px-4 py-3 text-loss lg:gap-4 lg:rounded-[18px] lg:px-6 lg:py-4">
        <span class="text-[14px] leading-[1.3] font-medium lg:text-[17px]">Столько денег вы потеряли</span>
        <span class="text-[19px] font-semibold whitespace-nowrap lg:text-[28px]">−{formatRub(lossRub)}</span>
      </div>
    </div>
  </div>
</section>
