---
import { DEMO, FORECASTS } from "../data/forecast";
const f = FORECASTS[0];
---
<div class="w-full max-w-[390px] rounded-[14px] bg-white p-5 shadow-[var(--shadow-card)] lg:p-6">
  <p class="text-xs font-medium text-muted">Пример билета</p>
  <div class="mt-4 flex items-center justify-between gap-3">
    <div><p class="text-[27px] font-semibold leading-none">{DEMO.from.code}</p><p class="mt-1 text-xs text-muted">{DEMO.from.city}</p></div>
    <span class="text-lg text-muted" aria-hidden="true">→</span>
    <div class="text-right"><p class="text-[27px] font-semibold leading-none">{DEMO.to.code}</p><p class="mt-1 text-xs text-muted">{DEMO.to.city}</p></div>
  </div>
  <div class="mt-5 flex items-end justify-between gap-3 border-t border-line pt-4">
    <div><p class="text-xs text-muted">{DEMO.trip}</p><p class="mt-1 text-xl font-semibold">{DEMO.price}</p></div>
    <div class="text-right" aria-live="polite"><p class="fc-text text-sm font-semibold"><span data-f="arrow">{f.arrow}</span> <span data-f="label">{f.label}</span></p><p class="mt-1 text-xs text-muted" data-f="advice">{f.advice}</p></div>
  </div>
</div>
