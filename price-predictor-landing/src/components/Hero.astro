---
import Logo from "./Logo.astro";
import CtaButton from "./CtaButton.astro";
import Ticket from "./Ticket.astro";
---
<section class="px-4 pt-5 pb-8 sm:px-6 lg:pt-10 lg:pb-14">
  <div class="mx-auto max-w-[1120px] overflow-hidden rounded-[18px] bg-white shadow-[var(--shadow-card)]">
    <header class="flex items-center justify-between border-b border-line px-5 py-4 lg:px-10">
      <Logo circleClass="size-8" dotClass="size-[7px]" textClass="text-[17px]" class="gap-2.5" />
      <CtaButton variant="dark" class="hidden h-11 px-5 text-sm lg:flex" />
    </header>
    <div class="grid gap-9 px-5 py-9 lg:grid-cols-[1.1fr_.9fr] lg:items-center lg:gap-12 lg:px-10 lg:py-16">
      <div>
        <h1 class="m-0 max-w-[660px] text-[32px] leading-[1.1] font-semibold tracking-[-.035em] lg:text-[52px]">
          Подешевеет ли авиабилет?
        </h1>
        <p class="mt-4 max-w-[560px] text-[15px] leading-6 text-muted lg:text-lg lg:leading-7">
          Укажите маршрут, даты поездки и пассажиров. Чекбилет покажет тестовый прогноз и подскажет, покупать билет сейчас или подождать.
        </p>
        <CtaButton class="mt-7 h-14 w-full text-base sm:w-auto sm:px-8" />
      </div>
      <div class="flex min-w-0 items-center justify-center rounded-[14px] bg-[var(--field)] px-4 py-8 lg:px-7 lg:py-12">
        <Ticket />
      </div>
    </div>
  </div>
</section>
