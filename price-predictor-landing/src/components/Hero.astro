---
import Logo from "./Logo.astro";
import CtaButton from "./CtaButton.astro";
import Ticket from "./Ticket.astro";
---
<section
  class="hero flex h-svh min-h-[540px] flex-col items-center gap-4 overflow-hidden px-[22px] pt-[52px] pb-[30px] text-center lg:h-svh lg:max-h-[900px] lg:min-h-[600px] lg:gap-6 lg:px-10 lg:pt-10 lg:pb-[72px] xl:px-20"
  style="background: linear-gradient(180deg, #f4faff 0%, #cbe9fd 34%, #3781fc 76%, #1951fc 100%)"
>
  <header class="flex w-full items-center justify-center lg:justify-between">
    <Logo circleClass="size-8 lg:size-9" dotClass="size-[9px] lg:size-2.5" textClass="text-[20px] lg:text-[22px]" class="gap-2.5 lg:gap-3" />
    <CtaButton variant="dark" class="hidden h-[46px] px-6 text-[16px] lg:flex" />
  </header>

  <div class="hero-visual grid min-h-0 w-full flex-1 place-items-center">
    <div class="hero-art relative grid place-items-center">
    <div aria-hidden="true" class="absolute size-[330px] rounded-full border border-[rgba(25,81,252,.18)] lg:size-[560px] lg:border-[rgba(25,81,252,.16)]"></div>
    <div aria-hidden="true" class="absolute size-[230px] rounded-full border border-[rgba(25,81,252,.26)] lg:size-[400px] lg:border-[rgba(25,81,252,.24)]"></div>
    <Ticket />
    </div>
  </div>

  <h1 class="hero-title m-0 text-[31px] leading-[1.1] font-semibold tracking-[-0.02em] text-white [text-shadow:0_2px_16px_rgba(3,25,91,.35)] lg:max-w-[900px] lg:text-[60px] lg:leading-[1.06] lg:tracking-[-0.025em] lg:[text-shadow:0_2px_20px_rgba(3,25,91,.35)]">
    Подешевеет ли авиабилет? <span class="text-accent">Проверьте</span> перед покупкой!
  </h1>
  <p class="hero-subtitle m-0 text-[15px] leading-[1.5] text-white [text-shadow:0_1px_10px_rgba(3,25,91,.3)] lg:max-w-[640px] lg:text-[20px]">
    Укажите маршрут, даты поездки и пассажиров. Чекбилет спрогнозирует изменение цены и подскажет, покупать билет сейчас или подождать.
  </p>
  <CtaButton class="mt-1 h-[58px] self-stretch text-[17px] shadow-[0_10px_30px_rgba(3,25,91,.25)] lg:mt-2 lg:h-16 lg:w-[340px] lg:self-center lg:text-[19px] lg:shadow-[0_12px_34px_rgba(3,25,91,.28)]" />
</section>
