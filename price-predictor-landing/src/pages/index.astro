---
import "../styles/global.css";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import Solution from "../components/Solution.astro";
import FinalCta from "../components/FinalCta.astro";

const title = "Чекбилет — подешевеет ли авиабилет?";
const description =
  "Укажите маршрут, даты поездки и пассажиров. Чекбилет спрогнозирует изменение цены и подскажет, покупать билет сейчас или подождать.";
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f4f6" />
  </head>
  <body class="m-0">
    <main class="mx-auto max-w-[480px] lg:max-w-none" data-forecast-root data-fc="0">
      <Hero />
      <Problem />
      <Solution />
      <FinalCta />
    </main>
    <script>
      import { initForecastCycle } from "../scripts/forecast-cycle";
      initForecastCycle();
    </script>
  </body>
</html>
